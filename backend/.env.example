# ProxyBridge configuration. Copy to .env and fill in real values.
# The three secrets below have no working defaults: the service refuses to
# start if any of them is missing, too short, or still set to an example value.

# --- Required secrets -------------------------------------------------------
# Admin panel password, at least 8 characters.
ADMIN_PASSWORD=change-me
# Signing key for admin JWTs, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# Encrypts upstream proxy URIs at rest, at least 16 characters.
# Generate: openssl rand -hex 32
# WARNING: changing this value makes existing proxy URIs undecryptable; the
# service will refuse to start rather than serve broken nodes.
PROXY_ENCRYPTION_KEY=replace-with-a-long-random-secret

# --- Web panel --------------------------------------------------------------
# 127.0.0.1 keeps the panel local-only. Use 0.0.0.0 only behind a firewall.
HOST=127.0.0.1
PORT=3000
JWT_EXPIRES_IN=12h
# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For, otherwise
# login rate limiting would see every client as the same address.
TRUST_PROXY=0

# --- Local proxy nodes ------------------------------------------------------
# Host the managed proxy ports bind to. install.sh sets this to match the panel
# listen address: 127.0.0.1 keeps them local-only, 0.0.0.0 exposes them on the
# server address (firewall them before doing that).
LOCAL_PROXY_HOST=0.0.0.0
LOCAL_PORT_START=8001
LOCAL_PORT_END=8999
DATABASE_PATH=./data/data.db

# --- Proxy testing ----------------------------------------------------------
IP_CHECK_URL=https://api.ipify.org?format=json
PROXY_TEST_TIMEOUT_MS=15000

# --- Update checks ----------------------------------------------------------
# The panel polls /api/version while updating; this cache keeps that from
# turning into a burst of GitHub requests.
VERSION_CACHE_TTL_MS=60000

# --- Login rate limiting ----------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=300000
LOGIN_BLOCK_MS=900000
